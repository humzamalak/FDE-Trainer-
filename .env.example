# Copy this file to .env and fill in your key. Never commit .env.
# Get a key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Model for the tutor and generated exercises.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Maximum length of one tutor reply (tokens).
TUTOR_MAX_TOKENS=2000

# Monthly spend limit in USD for all AI features. 0 = no limit.
MONTHLY_BUDGET_USD=10

# Prices in USD per million tokens, used to estimate cost. Check current prices for your model.
PRICE_INPUT_PER_MTOK=3
PRICE_OUTPUT_PER_MTOK=15
PRICE_CACHE_WRITE_PER_MTOK=3.75
PRICE_CACHE_READ_PER_MTOK=0.30
